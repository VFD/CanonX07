10 BEEP 90,10: PRINT"****** OPTION ******(A)CRE --> HECTARE  (H)ECTARE --> ACRE"
20 J$=INKEY$: IF J$="H" THEN 80
30 IF J$<>"A" THEN 20
40 REM *ENTREES DES DONNEES ET RESULTAT*
50 BEEP 90,10: CLS: INPUT"MESURE EN ACRES ";A
70 BEEP 90,10: CLS: PRINT"MESURE EN HECTARES=",A/2.471: GOTO 100
80 CLS: BEEP 90,10: INPUT"MESURE EN HECTARES ";H
