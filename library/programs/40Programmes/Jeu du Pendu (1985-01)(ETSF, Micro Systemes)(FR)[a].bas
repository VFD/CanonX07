270 LINE(32,18)-(29,15): LINE(32,18)-(35,15): RETURN
280 LINE(32,22)-(29,25): LINE(32,22)-(35,25)
300 FOR W=1000 TO 3000 STEP 50: BEEP W,4: NEXT W: CLS
305 PRINT"***** PENDU !! *****C'ETAIT ";R$
310 BEEP 100,20: LOCATE 0,2: PRINT"REJOUEZ-VOUS: O/N ?"
320 F$=INKEY$:IF F$="O" THEN 7
