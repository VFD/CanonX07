117 REM *chargement*
120 RESTORE 50: FOR X=0 TO 79: READ A$(X): NEXT X: R$=A$((B-1)*10+INT(RND(0)*10))
125 S=LEN(R$): FOR K=1 TO S: G$=G$+"": NEXT K: CLS: FOR T=200 TO 1 STEP-10
127 BEEP T,2: NEXT T
130 GOSUB 200: BEEP 200,5: V=V+1: LOCATE 8,1: PRINTG$: IF G$=R$ THEN 350
140 E$=INKEY$: IFE$="" THEN 140 ELSE IF E$<"A" OR E$>"Z" THEN 140
150 FOR L=1 TO S: IF MID$(R$,L,1)<>E$ THEN NEXT L: U=U+1: GOTO 130
160 IF L=1 THEN G$=E$+MID$(G$,2,S-1): GOTO 190
170 IF L=S THEN G$=MID$(G$,1,S-1)+E$: GOTO 190
180 G$=MID$(G$,1,L-1)+E$+MID$(G$,L+1,S-L)
190 FOR D=L+1 TO S: IF MID$(R$,D,1)<>E$ THEN NEXT D: GOTO 130 ELSE L=D: GOTO 160
200 IF U=0 THEN RETURN ELSE ON U GOTO 210,220,230,240,250,260,270,280
210 LINE(0,31)-(30,31): RETURN
220 LINE(15,31)-(15,0): RETURN
230 LINE(15,0)-(32,0): RETURN
240 LINE(32,0)-(32,9): RETURN
250 LOCATE 5,1: PRINT"": GOTO 240
