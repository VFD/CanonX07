5 REM *** FACTORIELLES ***
7 CLS: CLEAR: CONSOLE 0,4,0,1,0: CONSOLE@1,1,0
10 BEEP 90,20 :INPUT"VOTRE VALEUR ";Z
20 FOR I=1 TO 2: K=K+(LOG(1)/LOG(10)): NEXT J
30 BEEP 90,10: CLS: PRINT Z;"! ="
40 PRINT 10^(K-INT(K));"* 10 ^";INT(K)
50 IF INKEY$<>" " THEN 50
60 CLS: BEEP 90,10: PRINT "AUTRE CALCUL O/N ?"
70 J$=INKEY$: IF J$="O" THEN 7
80 IF J$="N" THEN PRINT"*** A BIENTOT !! ***": BEEP 90,20: END
90 GOTO 70
