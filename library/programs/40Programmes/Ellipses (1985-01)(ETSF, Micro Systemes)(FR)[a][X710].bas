5 REM *** ELLIPSES ***
7 CLS: CLEAR 200: CONSOLE 0,4,0,1,0: CONSOLE@1,1,0
10 FOR T=1 TO 10: BEEP T,2: NEXT T: LPRINT CHR$(18): FOR U=1 TO 8: LPRINT"F": NEXT U: LPRINT"I"
20 LPRINT "M250,0": LPRINT"I"
25 REM *OPTIONS*
30 BEEP 90,10: PRINT"TAILLE DE 1 A 9 ?"
40 G$=INKEY$: T=VAL(G$): IF T>0 THEN IF T<10 THEN 50
45 GOTO 40
50 BEEP 50,10: PRINT"COULEUR DE 1 A 4 ?"
60 Q$=INKEY$: Z=VAL(Q$): IF Z>0 THEN IF Z<5 THEN 70
65 GOTO 60
70 Z=Z-1: BEEP 90,10: PRINT"APLATISSEMENT: 1-5 ?"
72 K$=INKEY$: R=VAL(K$): IF R>0 THEN IF R<6 THEN 90
75 GOTO 72
90 FOR I=0 TO 6.28 STEP .07
100 X=COS(I)*V: Y=SIN(I)*W
110 REM *TRACE*
130 LPRINT"C";Z: LPRINT"D0,0,"+STR$(X)+","+STR$(Y): NEXT I
140 FOR U=1 TO 5: LPRINT"F": NEXT U: LPRINT"A"
150 CLS: BEEP 90,20: PRINT" AUTRE DESSIN :O/N ?"
160 J$=INKEY$: IF J$="O" THEN 7
170 IF J$="N" THEN CLS: PRINT"*** A BIENTOT !! ***": BEEP 90,20: END
180 GOTO 160
