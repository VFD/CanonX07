5 REM *** PETIT POUCET ***
7 CLEAR: CLS: CONSOLE0,4,0,1,0: CONSOLE@1,1,0
10 FOR G=100 TO 300 STEP 5: BEEP G,2: NEXT G
20 PRINT"TAILLE DE LA FORET DE 1 A 9 ?": Y=7
30 A$=INKEY$: T=VAL(A$): IF T>0 THEN IF T<10 THEN T=T*2: GOTO 50
40 GOTO 30
50 CLS: LOCATE 0,2: BEEP 50,20: PRINT"UN INSTANT....S.V.P"
55 REM *FORMATION DU LABYRINTHE*
60 FOR J=1 TO T*6-1: FOR K=0 TO 15
70 IF RND(1)>.5 THEN PSET(J,K) ELSE PRESET (J,K)
80 NEXT K: BEEP 50,2: NEXT J: FOR C=1 TO 100 STEP 2: BEEP C,1: NEXT C: M=INT(RND(0)*T*3+5)
80 LOCATE 0,2: PRINT"***** PRET ? *****"
100 IF INKEY$="" THEN 100
160 LOCATE 0,2: PRESET(V,W): BEEP 100,5: PRINT"GRENADES =";M;" ": PSET(X,Y): V=X: W=Y
165 F$=INKEY$: IF F$=" " THEN 220
167 REM *DEPLACEMENTS*
170 S=STICK(3): IF S=3 THEN IF POINT(X+1,Y)=0 THEN X=X+1
180 S=STICK(7): IF X>0 THEN IF S=7 THEN IF POINT(X-1,Y)=0 THEN X=X-1
180 S=STICK(5): IF S=5 THEN IF POINT(X,Y+1)=0 THEN Y=Y+1
200 S=STICK(1): IF Y>0 THEN IF S=1 THEN IF POINT(X,Y-1)=0 THEN Y=Y-1
210 GDTO 250
220 IF POINT(X+1,Y)=-1 THEN IF M>0 THEN FOR V=100 TO 1 STEP -5: BEEP V,2: NEXT V: X=X+1: M=M-1
250 O=O+1: IF X<0 THEN X=0
260 IF X>T*6-1 THEN 300
270 IF Y<0 THEN Y=0
280 IF Y>15 THEN Y=15
280 GOTO 160
295 REM *FIN DU JEU*
300 FOR L=1 TO 1000 STEP -5: BEEP L,3: NEXT L: CLS
310 PRINT"SCORE =";INT((1000*T+M*20)/O);" POINTS"
320 LOCATE 0,1: PRINT"REJOUEZ-VOUS: O/N ?"
330 H$=INKEY$: IF H$="O" THEN 7
340 IF H$="N" THEN CLS: PRINT"*** A BIENTOT !! ***": BEEP 99,20: END
350 GOTO 330