5 REM *** CINEMATIQUE ***
7 CLS: CLEAR: CONSOLE 0,4,0,1,0: CONSOLE@1,1,0
10 FOR W=1 TO 100 STEP 5: BEEP W,2: NEXT W
20 PRINT"****** OPTION ******NIVEAU : DE 1 A 3 ?"
30 N$=INKEY$: N=VAL(N$): IF N>0 THEN IF N<4 THEN 50
40 GOTO 30
45 REM *QUESTIONS*
50 Z=INT(RND(0)*50+10): GOSUB 300: X=Z^Z*.5
60 PRINT"HAUTEUR MAXIMALE ";: GOSUB 170: X=Z/5
70 GOSUB 300: PRINT"TEMPS DE RETOMBEE ";: GOSUB 170
75 T=INT(RND(0)*Z*2)/10+1: IF T>X THEN 75
80 X=Z-T*10: GOSUB 300: PRINT"SA VITESSE APRES...";T;"SECONDES ";: GOSUB 170
90 FOR U=1 T0 200 STEP 10: BEEP U,2: NEXT U
95 REM *JEU TERMINE*
100 CLS: PRINT"**** TERMINE !! ****SCORE =";S;"/ 3 ESSAIS"
110 LOCATE 0,2: BEEP 90,10: PRINT"REJOUEZ-VOUS : O/N ?"
120 G$=INKEY$: IF G$="O" THEN 7
130 IF G$="N" THEN CLS: BEEP 90,20: PRINT"*** A BIENTOT !! ***": END
140 GOTO 120
160 REM *DEMANDE DES RESULTATS*
170 INPUT R: E=(X*N*10)/100: IF R+E>=X THEN IF R-E<=X THEN 200
180 FOR D=800 TO 900 STEP 5: BEEP D,2: NEXT D
190 CLS: PRINT"REPONSE LOINTAINE !!": GOTO 220
200 FOR D=100 TO 1 STEP -5: BEEP D,2:NEXT D
210 CLS: PRINT"REPONSE APPROCHEE !!": S=S+1
220 PRJNT"REPDNSE =";X
230 IF INKEY$<>" " THEN 230 ELSE RETURN
300 CLS: BEEP 90,10: PRINT"VITESSE =";Z;"M/S": BEEP 50,10: RETURN

