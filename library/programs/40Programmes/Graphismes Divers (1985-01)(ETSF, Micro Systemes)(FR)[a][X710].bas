5 REM *** GRAPHISMES DIVERS ***
7 CLS: CLEAR: CONSOLE 0,4,0,1,0: CONSOLE@1,1,0
10 FOR T=1 TO 100 STEP 5: BEEP T,3: NEXT T
15 PRINT"1:RECTANGLE   2:ROND3:CARRE   4:TRIANGLE"
20 A$=INKEY$: B=VAL(A$): IF B>0 THEN IF B<5 THEN 40
30 GOTO 20
40 CLS: BEEP 56,10: PRINT"TAILLE : DE 1 A 5 ?"
50 A$=INKEY$: C=VAL(A$): IF C>0 THEN IF C<6 THEN CLS: ON B GOTO 100,200,300,400
60 GOTO 50
100 L=24*C: H=6*C+1: X=(120-L)/2: Y=(32-H)/2: IF L=120 THEN L=119
120 LINE(X,Y)-(X+L,Y): BEEP 1,5: LINE(X+L,Y)-(X-L,Y+H): BEEP 50,5
130 LINE(X+L,Y+H)-(X,Y+H): BEEP 100,5: LINE(X,Y+H)-(X,Y): GOTO 500
200 R=3*C: BEEP 50,10: CIRCLE(59,16),R: GOTO 500
300 L=6*C+1: H=L: X=(120-L)/2: Y=(32-H)/2: GOTO 20
400 L=24*C: X=(120-L)/2: H=(32-6*C)
410 LINE(X,31)-(X+L,31): BEEP 10,5: LINE(X+L,31)-(X+(L/2),H): BEEP 100,5
420 LINE(X+(L/2),H)-(X,31)
500 FOR R=100 TO 200 STEP 5: BEEP R,3: NEXT R
510 J$=INKEY$: IF J$=" " THEN 550
520 IF J$="T" THEN 600
530 GOTO 510
550 CLS: BEEP 90,10: PRINT"AUTRE DESSIN : O/N ?"
560 J$=INKEY$: IF J$="O" THEN 7
570 IF J$="N" THEN PRINT"*** A BIENTOT !! ***": BEEP 90,20: END
580 GOTO 560
600 FOR H=1 TO 10: BEEP H,2: NEXT H: CLEAR: X=59: Y=16
610 REM *OPTION TELECRAN*
630 H$=INKEY$: IF H$=" " THEN C=1: FOR U=1 TO 100 STEP 10: BEEP U,2: NEXT U
635 IF H$="L" THEN C=0: FOR G=100 TO 1 STEP -10: BEEP G,2: NEXT G
640 S=STICK(6): IF S=6 THEN X=X-1: Y=Y+1
650 S=STICK(5): IF S=5 THEN Y=Y+1
660 S=STICK(4): IF S=4 THEN Y=Y+1: X=X+1
670 S=STICK(7): IF S=7 THEN X=X-1
680 S=STICK(3): IF S=3 THEN X=X+1
690 S=STICK(8): IF S=8 THEN X=X-1: Y=Y-1
700 S=SIICK(1): IF S=1 THEN Y=Y-1
710 S=STICK(2): IF S=2 THEN Y=Y-1: X=X+1
715 REM *DESSIN*
720 GOSUB 760: IF C=1 THEN BEEP 2000,1: PRESET(A,B): PSET(X,Y): GOTO 730
725 PSET(X,Y): BEEP 1,1
730 H$=INKEY$: IF H$="F" THEN 500
750 A=X: B=Y: GOTO 630
755 REM *VERIFICATIDNS*
760 IF X<0 THEN X=0
770 IF Y<0 THEN Y=0
780 IF X>119 THEN X=119
790 IF Y>31 THEN Y=31
800 RETURN
