5 REM *** SURFACES DIVERSES ***
7 CLS: CLEAR: CONSOLE 0,4,0,1,0: CONSOLE@1,1,0: PI=3.1415926
10 BEEP 90,10: PRINT"****** OPTION ******(1) (2) (3) (4) (5)"
20 G$=INKEY$: Z=VAL(G$): IF Z>0 THEN IF Z<6 THEN CLS: ON Z GOSUB 70,80,90,100,110: GOTO 40
30 GOTO 20
40 CLS: BEEP 90,20: PRINT"***** SURFACE *****";S: BEEP 89,10
50 PRINT "AUTRE CALCUL: O/N ?"
55 J$=INKEY$: IF J$="N" THEN CLS: PRINT"*** A BIENTOT !! ***": BEEP 90,20: END
60 IF J$="O" THEN 7
65 GOTD 55
67 REM *CARRE*
70 BEEP 90,10: INPUT"COTE DU CARRE ";C: S=C^2: RETURN
75 REM *CERCLE*
80 BEEP 99,10: INPUT"RAYON DU CERCLE ";R: S=PI*R^2: RETURN
85 REM *CYLINDRE*
90 BEEP 20,10: INPUT"RAYON DU CYLINDRE ";R : BEEP 90,10: CLS
92 INPUT"HAUTEUR DU CYLINDRE ";H: S=2*PI*R*(R+H): RETURN
95 REM *CUBE*
100 BEEP 60,10: INPUT"ARETE DU CUBE " ;A: S=6*A^2: RETURN
105 REM *SPHERE*
110 BEEP 90,10: INPUT"RAYON DE LA SPHERE ";R: S=4*PI*R^2: RETURN
