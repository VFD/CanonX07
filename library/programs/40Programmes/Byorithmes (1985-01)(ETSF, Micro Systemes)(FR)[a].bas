5 REM *** BIORYTHMES ***
7 CLS: CLEAR: CONSOLE 0,4,0,1,0: CONSOLE@1,1,0
10 FOR Z=1 TO 100 STEP 10: BEEP 2,2: NEXT Z: PRINT"**** 1ERE DATE: ****"
20 BEEP 40,10: C=100: I=I+1: INPUT "JOUR ";K: BEEP 20,10: INPUT"MOIS ";L: BEEP 20,10
30 INPUT"ANNEE";M: IF L>2 THEN 70
35 REM *MOIS 1 OU 2*
40 U=365*M+K+31*(L-1)+INT((M-1)/4)-INT(3/4*(INT((M-1)/C)+1))
50 Z(I)=U: IF I=1 THEN 20
60 GOTO 85
65 REM *AUTRES MOIS*
70 U=365*M+K+31*(L-1)-INT(.4*L+2.3)+INT(M/4-INT(3/4*(INT(M)/C)+1))
80 Z(I)=U: IF I=1 THEN CLS: PRINT"*** 2EME DATE: ***": BEEP 50,20: GOTO 20
83 REM * RESULTATS*
85 CLS: FOR V=1 TO 100 STEP 5: BEEP V,2: NEXT V: PRINT"****** CYCLES ******"
87 FOR I=1 TO 500: NEXT I: CLS
90 U=Z(2)-Z(1): A$="PHYEMOINT": X(1)=23: X(2)=28: X(3)=33: FOR I=1 TO 3: S=2
100 E=360*(U/X(I)): J=360*((E/360)-INT(E/360)): G=(J*3.1415926)/180: E=SIN(G): F=F+E
110 N:N+J: C$="HAUSSE": IF J>=82 THEN IF J=<262 THEN C$="BAISSE": S=1
120 IF J>=442 THEN C$="BAISSE": S=1
130 BEEP 9,9: GOSUB 210: PRINT MID$(A$,1+3*(I-1),3);"=";Q: LOCATE 9,I-1: PRINT "/EN ";C$
135 T=T+S: NEXT I: C$="HAUSSE": IF T<5 THEN C$="BAISSE"
140 IF INKET$<>" " THEN 140
150 BEEP 30,10: CLS: E=F/3: GOSUB 210: PRINT"MOYENNE =";Q: BEEP 60,10: I=1: T=0: F=0
160 PRINT"ELLE EST EN ";C$: LOCATE 2,2
170 BEEP 40,10: PRINT"UN AUTRE : O/N ?"
180 B$=INKEY$: IF B$="O" THEN CLS: PRINT"**** 2EME DATE: ****": BEEP 40,20: GOTO 20
190 IF B$="N" THEN CLS: PRINT"*** A BIENTOT !!": BEEP 45,20: END
200 GOTO 180
210 H$=STR$(E): Q=VAL(MID$(H$,1,5)): RETURN
