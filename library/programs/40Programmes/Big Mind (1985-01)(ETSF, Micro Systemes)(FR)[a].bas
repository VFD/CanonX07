100 CLS: F=1: INPUT"VOTRE REPONSE ";B$: IF LEN(B$)<>LEN(A$) THEN 100
105 D=D+1: IF A$=B$ THEN D=0: GOTO 170
107 IF D=2 THEN F=2
110 CLS: FOR G=1000 TO 3000 STEP 50: BEEP G,2: NEXT G
115 PRINT"***** FAUX !!! *****": FOR L=1 TO 600: NEXT L: ON F GOTO 100,120
