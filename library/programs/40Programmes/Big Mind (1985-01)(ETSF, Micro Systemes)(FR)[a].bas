70 FOR W=1 TO 15: CLS: IF O=1 THEN A$=A$+CHR$(INT(RND(0)*10+48)): GOTO 80
75 A$=A$+CHR$(INT(RND(0)*26+65))
80 FOR E=1 TO LEN(A$): BEEP 100,5: PRINT MID$(A$,E,1);" ";: NEXT E
90 FOR P=1 TO N*400: NEXT P: FOR U=900 TO 100 STEP -50: BEEP U,5: NEXT U
