10 FOR G=1 TO 100 STEP 2: BEEP G,1: NEXT G
15 PRINT"***** OPTION *****(C)HIFFRES/(L)ETTRES"
20 O=2: G$=INKEY$: IF G$="C" THEN O=1: GOTO 40
30 IF G$<>"L" THEN 20
40 FOR G=1 TO 100 STEP 2: BEEP G,1: NEXT G
