5 REM *** DISCRIMINANT ***
7 CLS: CLEAR: CONSOLE 0,4,0,1,0: CONSOLE@1,1,0
8 PRINT"**** AX^2+BX+C ****"
10 BEEP 90,10: INPUT "A ";A : BEEP 90,10: INPUT"B ";B: BEEP 90,10: INPUT"C ";C
15 REM *CALCUL*
20 CLS: D=B^2-4*A*C: BEEP 89,10: PRINT"DELTA =";D: FOR T=1 TO 800: NEXT T
30 IF D=0 THEN 60
40 IF D>0 THEN 70
45 REM *RESULTAT*
50 BEEP 50,10 : PRINT"**AUCUNE SOLUTIDN **": GOTO 85
55 REM *RACINE DOUBLE*
80 BEEP 90,10: PRINT"** RACINE DOUBLE : **X1=X2=";-B/(2*A): GOTO 85
65 REM *RACINES*
70 BEEP 90,10: PRINT"***2 SOLUTIONS : ***X1=";(-B-SQR(D))/(2*A)
80 PRINT"X2=";(-B+SQR(D))/(2*A)
85 IF INKEY$<>" " THEN 85
90 CLS: BEEP 89,20: PRINT"AUTRE CALCUL : O/N ?"
100 J$=INKEY$: IF J$="O" THEN 7
110 IF J$="N" THEN PRINT"*** A BIENTOT !! ***": BEEP 90,20: END
120 GOTO 100