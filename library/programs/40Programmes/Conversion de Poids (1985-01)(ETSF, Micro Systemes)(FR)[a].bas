5 REM *** CONVERSION DE POIDS ***
7 CLS: CLEAR: CONSOLE 0,4,0,1,0: CONSOLE@1,1,0
10 BEEP 20,20: PRINT"OPTION (1)  (2)  (3)  (4)"
20 G$=INKEY$: Z=VAL(G$): IF Z>0 THEN IF Z<5 THEN 40
30 GOTO 20
40 CLS: BEEP 90,20: ON Z GOTO 50,60,70,80
45 REM *ENTREES DES DONNEES ET RESULTAT*
50 INPUT"GRRAMMES ";G:    O=G*.0352733: BEEP  5,10: PRINT"OUNCES = ";O: GOTO 90
60 INPUT"OUNCES ";O :     G=28.35*O:    BEEP 90,20: PRINT"GRAMMES =";G: GOTO 90
70 INPUT"KILOGRAMMES ";K: P=K*2.2046:   BEEP 40,20: PRINT"POUNDS =";P:  GOTO 90
80 INPUT"POUNDS ";P:      K=P*.4536:    BEEP 90,20: PRINT"KILOGRAMMES =";K
90 IF INKEY$<>" " THEN 90
100 BEEP 90,20: CLS: PRINT"AUTRE CALCUL : O/N ?"
110 G$=INKEY$: IF G$="O" THEN 7
120 IF G$="N" THEN PRINT"*** A BIENTOT !! ***": BEEP 90,20: END
130 GOTO 110
