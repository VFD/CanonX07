10 BEEP 90,20: PRINT"****** OPTION ****** (1)(2)(3)(4)(5)(6)"
20 G$=INKEY$: Z=VAL(G$): IF Z>0 THEN IF Z<7 THEN 40
30 GOTO 20
40 N$="": CLS: BEEP 90,20: ON Z GOTO 50,60,70,80,90,100
45 REM *CALCULS ET RESULTATS*
50 PRINT N$;: INPUT F: V=F*15^5: BEEP 5,5: PRTNT"DYNES =";V: GOTO 110
60 INPUT"DYNES ";F: V=F*15^-5: BEEP 5,5: PRINT N$;"=";V: GOTO 110
70 INPUT "KILOGRAMMES POIDS ";F: V=F*9.807: BEEP 5,5: PRINT N$;"=";V: GOTO 110
80 PRINT N$;: INPUT F: V=F*.102: BEEF 5,5: PRINT"KILOGRAMMES POIDS =";V: GOTO 110
90 INPUT"POUNDS WEIGHT ";F: V=F*4.448: BEEP 5,5: PRINT N$;"=";V: GOTO 110
100 PRINT N$;: INPUT F: V=F*2248: BEEP 5,5: PRINT"POUNDS WELGHT =";V
110 IF INKEY$<>" " THEN 110
120 BEEP 90,20: CLS: PRINT"AUTRE CALCUL : O/N ?"
130 J$=INKEY$: IF J$="O" THEN 7
140 IF J$="N" THEN PRINT"*** A BIENTOT !! ***": BEEP 90,20: END
150 GOTO 130
