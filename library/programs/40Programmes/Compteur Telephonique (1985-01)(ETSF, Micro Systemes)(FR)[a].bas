70 D=(.05+(5.2E-4*(60/C)))/6: LOCATE 0,0: PRINT"PRIX ->";USING"####,##";E
80 FOR I=0 TO C STEP D: J$=INKEY$: IF J$="" THEN NEXT I: E=E+.645: BEEP 5,2: GOTO 70
