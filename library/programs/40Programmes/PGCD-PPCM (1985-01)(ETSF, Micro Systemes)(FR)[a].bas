5 REM *** PGCD-PPCM ***
7 CLS: CLEAR: CONSOLE 0,4,0,1,0: CONSOLE@1,1,0: A=1
10 BEEP 50,1: INPUT"CHOIX:2 A 10 NOMBRES";B: IF B>=2 THEN IFB <10 THEN CLS: GOTO 20
15 GOTO 10
17 REM *ENTREES DES DONNEES*
20 FOR C=1 TO B: BEEP 10,2: PRINT"NOMBRE";C;: INPUT D: IF D=>1 THEN D=INT(D): A(C)=D: GOTO 40
30 FOR G=800 TO 900 STEP 5: BEEP G,2: NEXT G: GOTO 20
40 A=A*D: NEXT C: E=A(1): FOR C=2 TO B: F=E: E=A(C)
45 REM *CALCUL DU PGCD ET DU PPCM*
50 V=(INT(F/E)*E-F): IF V=0 THEN 170
60 F=E: E=V: GOTO 50
70 A=A/E: NEXT C: CLS: BEEP 50,10: PRINT"PGCD =";E: BEEP 50,10: PRINT"PPCM =";A
75 IF INKEY$<>" " THEN 75
80 CLS: BEEP 200,10: PRINT "AUTRE CALCUL O/N ?"
90 G$=INKEY$: IF G$="O" THEN 7
100 IF G$="N" THEN PRINT"*** A BIENTOT !! ***": BEEP 300,20: END
110 GOTO 90
