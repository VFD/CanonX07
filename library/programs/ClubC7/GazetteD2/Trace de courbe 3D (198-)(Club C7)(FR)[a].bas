140 G$=INKEY$: IF G$>="0" AND G$=<"9" THEN O=VAL(G$): T=1+O/10 ELSE 140
150 DIM B(255), H(255): LPRINT CHR$(17): CLS: BEEP 9,3
160 INPUT"X1 ";X1: INPUT"X2 ";X2: INPUT"Y1 ";Y1: INPUT"Y2 ";Y2: INPUT"PAS X3 ";X3
170 INPUT"PAS Y3 ";Y3: X4=X1: Y4=Y1: Y=Y1: IF X1>=X2 OR Y1>=Y2 THEN 160
180 C=255/((X2-X1)+(Y2-Y1))/.866: F=INT((X2-X1)*.866*C)
190 BEEP 4,4: PRINT"COEFFICIENT ";C: INPUT"REDUCTION/Z ";Z1
200 LPRINT"X1 =";X1: LPRINT"X2 =";X2: LPRINT"Y1 =";Y1: LPRINT"Y2 =";Y2
210 LPRINT"PAS X3 =";X3: LPRINT"PAS Y3 =";Y3
220 LPRINT"COEFFICIENT =";C: LPRINT Z1
230 LPRINT"TAILLE DU GRAPHE :";O: LPRINT"TIME = ";TIME$: LPRINT CHR$(18)
240 LPRINT"M"; 150/T;",";-310*T: LPRINT"I": J=0: LPRINT"M";-30*T;",";284*T
250 LPRINT"D";-30*T;",";284*T;",";-10*T;",";284*T;",0,";300*T
250 LPRINT"D";-10*T;",";284*T;",0,";268*T: LPRINT"C";M
270 D=0: A=F+INT((Y-Y4)*.866*C): H=A
280 X=X4+Y-Y4+(F-A)/C/.866
290 IF X<X1 THEN A=A-1: GOTO 280
300 IF X>X2 THEN 420
310 Z=FN F(X,Y)
320 IF E=0 AND ABS(Z*Z1)>100 THEN CLS: PRINT"REDUCTION/Z";Z;Z1;: INPUT Z1: GOTO 320
330 E=1: B=((X-X4)+(Y-Y4))/2*C+Z*Z1
340 IF J=0 THEN H(A)=B: B(A)=B
350 IF A>=I THEN H(A)=B: B(A)=B
360 IF D=0 THEN 390
370 IF B>=H(A) THEN H(A)=B: LPRINT"M";Q*T;",";W*T: LPRINT "D";B*T;",";A*T: GOTO 390
380 IF B<=B(A) THEN B(A)=B: LPRINT "M" ;Q*T;",";W*T: LPRINT "D";B*T;",";A*T
390 D=1: Q=B: W=A
400 IF A/2<>INT(A/2) THEN A=A-1: GOTO 280
410 A=A-2: GOTO 280
420 Y=Y+3: J=1: I=H: LPRINT"C";V: IF Y<Y2 THEN 270
430 IF G<>1 THEN LPRINT"C";M: Y=Y2: G=1: GOTO 270
440 Y=Y1: X=X1: J=0: G=0: LPRINT "C";M
450 D=0: A=F-INT((X-X4)*.866*C): H=A
460 E=1: Y=X-X4+Y4+(A-F)/C/.866
470 IF Y<Y1 THEN A=A+1: GOTO 460
480 IF Y>Y2 THEN 590
490 Z=FN F(X,Y)
500 B=((X-X4)+(Y-Y4))/2*C+Z*Z1
510 IF J=0 THEN H(A)=B: B(A)=B
520 IF A<=I THEN H(A)=B: B(A)=B
530 IF D=0 THEN 560
540 IF B>H(A) THEN H(A)=B: LPRINT"M";Q*T;",";W*T: LPRINT"D";B*T;",";A*T: GOTO 560
550 IF B<=B(A) THEN B(A)=B: LPRINT"M";Q*T;",";W*T: LPRINT"D";B*T;",";A*T
560 Q=B: W=A: D=1
570 IF A/2<>INT(A/2) THEN A=A+1: GOTO 460
580 A=A+2: GOTO 460
590 X=X+X3: J=1: I=H: LPRINT"C";V: IF X<X2 THEN 450
600 IF G<>1 THEN LPRINT "C" ;M :X=X2 :G=1 :GOTO 450
610 LPRINT"C";V:LPRINT"M-70,-100":LPRINT CHR$(17): LPRINT"TIME = ";TIME$: BEEP 9,4
620 CLS: PRINT"AUTRE FONCTION:O/N ?"
630 G$=INKEY$: IF G$="0"THEN 30 ELSE IF G$="N" THEN CLS:END
640 GOTO 630
