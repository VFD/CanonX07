50 IF LEN(A$)>66 THEN CLS: PRINT"F(Z) EST TROP LONGUE";: H=INP(#1): GOTO40
60 KEY$(6)="..."+" 80 DEF FNF(X,Y)="+A$+CHR$(13)+"GOTO 80"+CHR$(13)
