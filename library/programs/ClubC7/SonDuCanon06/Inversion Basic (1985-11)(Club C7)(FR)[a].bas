1 CLS: Q$=" BONJOUR"
5 FOR K=1 TO 5
10 POKE 41,0: POKE 42,64
20 LOCATE 5,1: PRINT Q$
25 FOR I=1 TO 150: NEXT
30 POKE 41,&H8F: POKE 42,&HE8
40 LOCATE 5,1: PRINT Q$: FOR I=1 TO 100: NEXT
50 NEXT K: END
100 CLEAR 200: D=32: P=96: GOSUB 120
110 D=64: P=60: GOSUB 120: END
120 FOR I=D TO D+31: J=I+P: A$=FONT$(I): C$=""
140 FOR K=2 TO 23 STEP 3: B$=MID$(A$,K,2): D$=STR$(252-VAL("&H"+B$))+","
150 C$=C$+D$: NEXT K
160 C$=MID$(C$,1,LEN(C$)-1)
170 FONT$(J)=C$: NEXT I: RETURN