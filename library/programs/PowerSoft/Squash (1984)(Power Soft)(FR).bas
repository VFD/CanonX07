1 REM (c) SQUASH POWERSOFT 1985
3 GOSUB 5000
5 BA=5
10 CLS
15 LOCATE 7,0:PRINT USING"SCORE : ####";SC
16 LOCATE 7,2:PRINT USING"BALLE : ####";BA
17 IF BA=0 THEN CLS:PRINT USING"VOTRE SCORE : ##### ";SC:END
20 LINE(0,0)-(31,0)
30 LINE-(31,31):LINE-(0,31)
80 VX=RND(1)+.5:VY=RND(1)+.5
90 XV=VX:YV=VY
100 XB=5:YB=INT(RND(1)*15)+10
110 PSET(XB,YB)
120 YR=15
130 LINE(2,YR)-(2,YR+2)
160 AX=XB:AY=YB
180 XB=XB+XV:YB=YB+YV
210 IF XB>=31 THEN XV=-VX:GOTO 340
220 IF YB<1 THEN YV=VY:GOTO 340
230 IF YB>=31 THEN YV=-VY:GOTO 340
250 IF XB<=3 AND YB>=YR AND YB<=YR+3 THEN XV=VX:BEEP 2000,1:GOTO 180
260 PRESET(AX,AY)
270 PSET(XB,YB)
280 IF XB<=2 THEN BEEP 5,4:FOR I=1 TO 30:PRESET(1,I):PRESET(2,I):NEXT I:BA=BA-1:GOTO 15
300 X=STICK(0):IF X=0 THEN 330
310 IF X=5 THEN IF YR<28 THEN YR=YR+1:PRESET(2,YR-1):PSET(2,YR+2):GOTO 330
320 IF X=1 THEN IF YR>1 THEN YR=YR-1:PRESET(2,YR+3):PSET(2,YR)
330 GOTO 160
340 BEEP 80,1:SC=SC+1
350 LOCATE 7,0:PRINT USING"SCORE : ####";SC
360 GOTO 180
5000 CLS:FOR I=0 TO 119 STEP 4:LINE(I,0)-(119-I,31):BEEP 200,2:NEXT I
5010 FOR I=0 TO 60 STEP 2:CIRCLE(59,15),I:BEEP 40,2:NEXT I
5020 LOCATE 5,1:PRINT"          ":LOCATE 5,2:PRINT"POWER SOFT"
5030 ME$="          POWER SOFT PROPOSE LE JEU DU SQUASH          "
5040 FOR I=1 TO LEN(ME$):LOCATE 5,1:PRINT MID$(ME$,I,10):FOR J=1 TO 50:NEXT J,I
5050 RETURN
