360 IF INKEY$="" THEN 360 ELSE 330
370 CLS:INPUT"VOULEZ-VOUS UN TRACEDANS LE SENS DIRECT";R$
380 R$=LEFT$(R$,1):IF R$="O" THEN JS=1 ELSE JS=-1
390 CLS:INPUT"INCREMENT ANGULAIRE    (en degres)";IA
400 IF OP=1 GOTO 520
409 '
