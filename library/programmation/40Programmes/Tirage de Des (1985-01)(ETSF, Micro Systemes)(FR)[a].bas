5 REM *** TIRAGE DE DES ***
7 CLS: CLEAR: CONSOLE 0,4,0,1,0: CONSOLE@1,1,0
10 FOR G=1 TO 200 STEP 10: BEEP G,2: NEXT G
20 PRINT"****** TIRAGE ******   DE 1 A 6 DES ?"
30 A$=INKEY$: B=VAL(A$): IF B>0 THEN IF B<8 THEN 50
40 GOTO 30
50 REM *TIRAGES ET AFFICHAGE*
50 CLS: FOR J=0 TO B-1: U=J*20: LINE(U,0)-(U+15,0): LINE(U,15)-(U+15,15)
60 LINE(U,0)-(U,15): LINE(U+15,0)-(U+15,15)
70 T=INT(RND(0)*6+1): ON T GOSUB 130,140,150,160,170,180: BEEP 100,T: NEXT J
75 FOR V=100 TO 1000 STEP 50: BEEP V,2: NEXT V
80 IF INKEY$<>" " THEN 80
90 CLS: BEEP 200,20: PRINT"UN AUTRE TIRAGE:O/N?"
100 F$=INKEY$: IF F$="O" THEN 7
110 IF F$="N" THEN PRINT"*** A BJENTOT !! ***": BEEP 90,30: END
120 GOTO 100
125 REM *ROUTINES GRAPHIQUES*
130 H=J*20+7: K=H+1: LINE(H,7)-(K,7): LINE(H,8)-(K,8): RETURN
140 H=J*20+2: K=H+1: LINE(H,2)-(K,2): LINE(H,3)-(K,3)
145 LINE(H+10,12)-(H+11,12): LINE(H+10,13)-(H+11,13): RETURN
150 GOSUB 140: GOSUB 130: RETURN
160 GOSUB 140: H=J*20+12: K=H+1: Q=H-10: R=Q+1
163 LINE(H,2)-(K,2): LINE(H,3)-(K,3)
166 LINE(Q,12)-(R,12): LINE(Q,13)-(R,13): RETURN
170 GOSUB 160: GOSUB 130: RETURN
180 GOSUB 160: H=J*20+2: K=H+1: Q=J*20+12: R=Q+1
190 LINE(H,7)-(K,7): LINE(H,8)-(K,8)
200 LINE(Q,7)-(R,7): LINE(Q,8)-(R,8): RETURN
