5 REM *** CANON LOGO ***
7 CLS: CLEAR 200: CONSOLE0,4,0,1,1: CONSOLE@1,1,0: LPRINT CHR$(18)
10 FOR K=1 TO 100 STEP 10: BEEPK,2: NEXT K: LPRINT"A": LPRINT CHR$(18)
20 FOR B=1 TO 5: LPRINT"F": NEXT B: LPRINT"I": GOSUB 400: FOR K=1 TO 50 STEP 10: BEEPK,5: NEXT K
30 LOCATE 0,0: PRINT"Vous pouvez dessiner": B=0: O=X: Q=Y
40 REM *OPTIONS*
50 S=STICK(1): IF S=1 THEN Y=Y+P: B=1
60 S=STICK(2): IF S=2 THEN X=X+P: Y=Y+P: B=1
70 S=STICK(3): IF S=3 THEN X=X+P: B=1
80 S=STICK(4): IF S=4 THEN Y=Y-P: X=X+P: B=1
90 S=STICK(5): IF S=5 THEN Y=Y-P: B=1
100 S=STICK(6): IF S=6 THEN X=X-P: Y=Y-P: B=1
110 S=STICK(7): IF S=7 THEN X=X-P: B=1
120 S=STICK(8): IF S=8 THEN X=X-P: Y=Y+P: B=1
130 IF X<0 THEN X=0
140 IF X>480 THEN X=480
150 IF B=1 THEN GOSUB 300
160 J$=INKEY$: IF J$="I" THEN GOSUB 400
170 IF J$="O" THEN LPRINT"I": X=0: Y=0: O=0: Q=0: BEEP 500,20
180 IF J$=CHR$(13) THEN D=1: BEEP 800,10
190 IF J$="H" THEN LPRINT"A": X=0: Y=0: O=0: Q=0: LPRINT CHR$(18): BEEP 100,20
200 IF J$="Q" THEN D=0: BEEP 10,20
205 IF J$="F" THEN 500
210 IF J$<>" " THEN 30
215 REM *ECRITURE*
220 CLS: BEEP 50,15: PRINT"COULEUR : De 1 A 4 ?"
230 G$=INKEY$: C=VAL(G$): IF C>0 THEN IF C<5 THEN C-C-1: GOTO 250
240 GOTO 230
250 BEEP 50,20: CLS: INPUT"TAILLE : De 0 A 15 ";T: IF T>=0  THEN IFT<16 THEN 270
260 GOTO 250
270 CLS: BEEP 50,20: PRINT"ROTATION : De 1 A 4 ?"
280 G$=INKEY$: R=VAL(G$): IF R>0 THEN IF R<5 THEN R=R-1: GOTO 290
285 GOTO 280
290 CLS: BEEP 50,10: INPUT"TEXTE ";E$: LPRINT"S";T: LPRINT"Q";R: LPRINT"C";C
295 LPRINT"P";E$: LPRINT"I": CLS: GOTO 30
297 REM *TRACE*
300 LPRINT"C";C: LPRINT"L";L: IF D=1 THEN 350
310 LPRINT"D"+STR$(O)+","+STR$(Q)+","+STR$(X)+","+STR$(Y): RETURN
350 LPRINT"M"+STR$(O)+","+STR$(Q)+","+STR$(X)+","+STR$(Y): RETURN
370 REM *INITIALISATION*
400 CLS: BEEP 50,20: INPUT"LIGNE : De 0 A 15 ";L: IF L>=0 THEN IF L<16 THEN 410
405 GOTO 400
410 BEEP 50,10: CLS: PRINT"COULEUR : De 1 A 4 ?"
420 A$=INKEY$: C=VAL(A$): IF C>0 THEN IF C<5 THEN C=C-1: GOTO 440
430 GOTO 420
440 CLS: BEEP 70,10: INPUT"PRECISION: De 1 A 10";P
450 IF P>0 THEN IF P<11 THEN BEEP 60,10: CLS: P=P*10*RETURN
460 GOTO 440
480 REM *SORTIE*
500 FOR T=1 TO 100 STEP 10: BEEP T,5: NEXT T: CLS
510 FOR D-1 TO 5: LPRINT"F": NEXT D: LPRINT"A"
520 BEEP 90,20: PRINT"Un autre dessin: O/N?"
530 H$=INKEY$: IF H$="O" THEN 7
540 IF H$="N" THEN CLS: PRINT"***A bientot!!": BEEP 90,20: END
550 GOTO 30