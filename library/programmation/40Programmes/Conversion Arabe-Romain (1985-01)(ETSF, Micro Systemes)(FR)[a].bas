5 REM *** CONVERSION ACRE <-> HECTARE ***
7 CLS: CLEAR: CONSOLE 0,4,0,1,0: CONSOLE@1,1,0
10 E=0: V=10: CLS: BEEP 30,20: INPUT"UOTRE NOMBRE ":N$: FOR I=1 TO LEN(N$)
15 REM *TRAITEMENT DES CHAINES*
20 IF MID$(N$,1,1)=" ": THEN NEXT I: GOTO 10
30 N$=MID$(N$,I,LEN(N$)-I+1): FOR J=1 TO LEN(N$)
40 A$=MID$(N$,J,1): GOSUB 50: Z=V*Z+R: NEXT J: GOTO 160
50 IF ASC(A$)>47 THEN IF ASC(A$)<58 THEN R=VAL(A$): RETURN
60 G=5040: FOR K=1 TO LEN(N$): A$=MID$(N$,K,1): H=1
70  IF A$="V" THEN H=5
80  IF A$="X" THEN H=V
90  IF A$="L" THEN H=50
100 IF A$="C" THEN H=100
110 IF A$="D" THEN H=500
120 IF A$="M" THEN H=1000
130 IF H=1 THEN IF A$<>"I" THEN 10
140 F=H: IF H>G THEN F=H-2*G
145 RE11 *RESULTAT EN ARABE*
150 G=P: E=E+F: NEXT K: BEEP 60,20: CLS: PRINT N$;" =";E: GOTO 340
160 BEEP 50,20: CLS: PRINT N$;" = ";
170 IF Z>999 THEN PRINT"M";: Z=Z-1000: GOTO 170
180 FOR L=1 TO 3: ON L GOSUB 310,320,330: B=INT(Z/V^(3-L))
190 ON B+1 GOSUB 210,220,230,240,250,260,270,280,290,300
200 Z=Z-B*V^(3-L): NEXT L: GOTO 340
205 REM *RESULTAT EN ROMAIN*
210 RETURN
220 PRINT N$;: RETURN
230 PRINT N$;N$;: RETURN
240 PRINT N$;N$;N$;: RETURN
250 PRINT N$;X$;: RETURN
260 PRINT X$;: RETURN
270 PRINT X$;N$;: RETURN
260 PRINT X$;: GOTO 230
290 PRINT X$; GOTO 240
300 PRINT N$;Y$;: RETURN
310 N$="C": X$="D": Y$="M": RETURN
320 Y$=N$: N$="X": X$="L": RETURN
330 Y$=N$: N$="I": X$="V": RETURN
540 IF INKEY$<>" " THEN 310
350 BEEP 56,20: CLS:  PRINT"UN AUTRE CALCUL : O/N?"
360 J$=INKEY$: IF J$="O" THEN 7
370 IF J$="N" THEN PRINT"*** A BIENTOT !! ***": BEEP 90,20: END
380 GOTO 360