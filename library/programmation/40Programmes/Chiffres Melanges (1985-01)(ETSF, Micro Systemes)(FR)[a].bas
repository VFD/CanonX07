5 REM *** CHIFFRES MELANGES ***
7 CLEAR: CONSOLE 0,4,0,1,0: CONSOLE@1,1,0: CLS: U=RND(0)
10 FOR Z=1 TO 100 STEP 5: BEEP Z,2: NEXT Z
20 PRINT"****** OPTION ******NIVEAU : DE 1 A 9 ?"
30 G$=INKEY$: Z=VAL(G$): IF Z>0 THEN IF Z<10 THEN 50
40 GOTO 30
50 FOR M=1 TO 9: A(M)=M: NEXT M: CLS
60 FOR O=1 TO Z: X=INT(RND(1)*4+1)
70 ON X GOSUB 210,220,230,240: NEXT O: GOTO 120
75 REM *ETAT DU JEU ET PROPOSITION*
80 Y=Y+1: FOR N=20 TO 1 STEP -1: BEEP N,2: NEXT N: LOCATE 0,0: PRINT"****** ESSAIS =";Y
85 LOCATE 3,1: PRINT"->";V;"<-": LOCATE 1,2: PRINT"(1)  (2)  (3)  (4)": BEEP 89,10
90 G$=INKEY$: W=VAL(G$): IF W>0 THEN IF W<5 THEN 110
100 GOTO 90
110 ON W GOSUB 210,220,230,240
120 V=0: FOR P=1 TO 9: V=(V+A(P))*10: NEXT P
130 V=V/10: IF V<>123456789 THEN 80
135 REM *GAGNE*
140 FOR T=100 TO 1 STEP -5: BEEP T,2: NEXT T: CLS
150 PRINT "***** GAGNE !! *****ESSAIS=";Y;"REJOUEZ-VOUS: O/N ?"
160 H$=INKEY$: IF H$="O" THEN 7
170 IF H$="N" THEN CLS: PRINT"*** A BIENTOT !! ***": BEEP 90,20: END
180 GOTO 160
