145 LOCATE 9,1
150 FOR I=230 TO 238:PRINT CHR$(I);:NEXT
160 LINE (49,0)-(109,0):LINE -(109,19):LINE -(49,19):LINE -(49,0)
170 LINE (51,2)-(107,2):LINE (107,17)-(51,17)
180 FOR I=51 TO 107 STEP 7:LINE (I,3)-(I,16):NEXT
