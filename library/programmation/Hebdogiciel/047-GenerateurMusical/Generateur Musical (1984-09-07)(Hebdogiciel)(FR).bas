210 FOR J=A-2 TO A+2:LINE (J,3)-(J,7):NEXT J,I
220 LINE (106,3)-(106,7):LINE (105,3)-(105,7)
290 REM jeu direct
300 A$=INKEY$:IF A$="" THEN 300 ELSE A=ASC(A$)-32
310 IF A>24 THEN 500 ELSE IF A>15 THEN A=A-10
320 BEEP N(A)+O*12,V:GOTO 300
500 B=1+((A=28)+(A=30)*2+(A=37)*3+(A=38)*4+(A=54)*5)*-1
510 ON B GOSUB 518,520,530,650,560,600
515 GOTO 300
518 RETURN
519 REM variation d'octave
520 O=O+(O<>0):GOTO 540
530 O=O-(O<3)
540 LOCATE 2,1:PRINT O;:RETURN
550 REM fin du jeu
560 FOR I=0 TO 3:FOR J=0 TO 19:LOCATE J,I:PRINT " ";:NEXT J,I
570 CLS:END
590 REM variation vitesse
600 LOCATE 16,3:PRINT "?";
610 A$=INKEY$:IF A$="" THEN 610 ELSE M=ASC(A$)
620 IF M<>60 AND M<>62 THEN LOCATE 15,3:PRINT V;:RETURN
630 IF (M=60 AND V<>0) THEN V=V-1 ELSE IF M=62 THEN V=V+1
640 LOCATE 15,3:PRINT V;:GOTO 610
645 REM enregistrement
650 LOCATE 1,2:PRINT "(P)lay";
660 A$=INKEY$:IF A$="" THEN 660 ELSE A=ASC(A$)-32
670 IF A>24 THEN 700 ELSE IF A>15 THEN A=A-10
680 BEEP N(A)+D*12,V
690 U$=INKEY$:IF U$="" THEN 690 ELSE IF U$=" " THEN 691 ELSE 660
691 NO%(Q)=N(A)+O*12:NO%(Q+1)=V:Q=Q+2:GOTO 660
695 GOTO 660
700 B=1+((A=48)+(A=28)*2+(A=30)*3+(A=38)*4+(A=54)*5)*-1
710 ON B GOSUB 660,900,520,530,990,600
720 GOTO 660
900 I=0
910 IF NO%(I)=0 THEN RETURN ELSE BEEP NO%(I),NO%(I+1)
920 I=I+2:GOTO 910
990 IF NO%(0)=0 THEN 1050 ELSE CLS:PRINT " Désirez-vous"
1000 PRINT " lister l'air","enregistré ?";
1010 T$=INKEY$:IF T$="" THEN 1010 ELSE IF T$<>"O" THEN CLS:END
1020 CLS:PRINT " Air enregistré :"," NOTE     VITESSE"
1025 PRINT " ----     -------"
1030 I=0
1040 IF NO%(I)=0 THEN 1100 ELSE LOCATE 0,3
1050 PRINT TAB(1);NO%(I);TAB(11);NO%(I+1);
1060 I=I+2:GOTO 1040
1100 CLS:END