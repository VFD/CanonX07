105 FONT$(231)="0,0,0,112,16,112,64,112"
110 FONT$(232)="0,0,0,56,8,56,8,56"
115 FONT$(233)="0,0,0,16,16,28,4,4"
120 FONT$(234)="0,0,0,12,8,12,0,12"
125 FONT$(235)="0,0,0,132,4,132,132,132"
130 FONT$(236)="0,0,0,192,0,192,64,192"
135 FONT$(237)="0,0,0,224,32,32,32,32"
140 FONT$(238)="0,0,0,112,80,112,80,112"
