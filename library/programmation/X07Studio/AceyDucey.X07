{"code":"\r\n// ----------------------------------------\r\n// ACEY DUCEY Memory\r\n// Retro Programmers For Obscure Systems\r\n// VincentD\r\n// ----------------------------------------\r\n// Variables\r\n// C$(0-3) : 4 Tableaux pour les cartes\r\n// T1$     : carte 1\r\n// T2$     : carte 2\r\n// T3$     : carte 3\r\n// T1      : valeur carte 1\r\n// T2      : valeur carte 3\r\n// T2      : valeur carte 3\r\n// S       : score\r\n// TJ      : temps de jeu\r\n// K$      : input clavier\r\n// I       : Index\r\n// ----------------------------------------\r\n\r\n// ----------------------------------------\r\n// Definitions pour simplifier la saisie\r\n// ----------------------------------------\r\n// DEF RANDOM [0,a]\r\n#DEF RND0[a]=INT(RND(1)*[a])\r\n\r\n// DEF RANDOM [1,a]\r\n#DEF RND1[a]=INT(RND(1)*[a]+1)\r\n// ----------------------------------------\r\n\r\n\r\n// ----------------------------------------\r\n// Le JEU\r\n// ----------------------------------------\r\nREM ----- Start of game\r\n@GAME\r\nGOSUB @INIT\r\nGOSUB @RESET\r\n\r\n// Timer jeu\r\nTJ=TIME\r\n\r\nREM ----- Debut de tour\r\n@Tour\r\nT1$=\"\":T2$=\"\":T3$=\"\"\r\nREM ----- Tire 3 cartes\r\nFOR I=1 TO 3\r\n  C=RND0[4]\r\n  ON C+1 GOSUB @PIQUE @COEUR @CARREAU @TREFLE\r\n  IF I=1 THEN T1$=STR$(C)+R$\r\n  IF I=2 THEN T2$=STR$(C)+R$\r\n  IF I=3 THEN T3$=STR$(C)+R$\r\nNEXT\r\n\r\n// ----------------------------------------\r\n// Affichage des cartes 1 et 2\r\n// ----------------------------------------\r\nREM ----- Affiche les cartes 1 et 2\r\nREM 1\r\nIF LEFT$(T1$,1)=\"1\":   LOCATE x1,y1: PRINT\"Pique\"\r\nIF LEFT$(T1$,1)=\"2\":   LOCATE x1,y1: PRINT\"Coeur\"\r\nIF LEFT$(T1$,1)=\"3\":   LOCATE x1,y1: PRINT\"Carreau\"\r\nIF LEFT$(T1$,1)=\"4\":   LOCATE x1,y1: PRINT\"Trefle\"\r\nIF RIGHT$(T1$,1)=\"0\":  LOCATE x1-1,y1: PRINT\"10\"\r\nIF RIGHT$(T1$,1)<>\"0\": LOCATE x1,y1: PRINT RIGHT$(T1$,1)\r\nREM 2\r\nIF LEFT$(T2$,1)=\"1\":   LOCATE x2,y2: PRINT\"Pique\"\r\nIF LEFT$(T2$,1)=\"2\":   LOCATE x2,y2: PRINT\"Coeur\"\r\nIF LEFT$(T2$,1)=\"3\":   LOCATE x2,y2: PRINT\"Carreau\"\r\nIF LEFT$(T2$,1)=\"4\":   LOCATE x2,y2: PRINT\"Trefle\"\r\nIF RIGHT$(T2$,1)=\"0\":  LOCATE x2-1,y2: PRINT\"10\"\r\nIF RIGHT$(T2$,1)<>\"0\": LOCATE x2,y2: PRINT RIGHT$(T2$,1)\r\n\r\n// ----------------------------------------\r\n// Choix du joueur\r\n// ----------------------------------------\r\nREM ----- Choix\r\n@Bet\r\nK$=\"\":K$=INKEY$\r\nIF K$=\"n\" THEN K$=\"N\"\r\nIF K$=\"o\" THEN K$=\"O\"\r\nIF K$<>\"N\" AND K$<>\"O\" THEN @Bet\r\n\r\n// ----------------------------------------\r\n// Affiche la 3eme carte\r\n// ----------------------------------------\r\nREM ----- affiche carte 3\r\nIF LEFT$(T3$,1)=\"1\":   LOCATE x3,y3: PRINT\"Pique\"\r\nIF LEFT$(T3$,1)=\"2\":   LOCATE x3,y3: PRINT\"Coeur\"\r\nIF LEFT$(T3$,1)=\"3\":   LOCATE x3,y3: PRINT\"Carreau\"\r\nIF LEFT$(T3$,1)=\"4\":   LOCATE x3,y3: PRINT\"Trefle\"\r\nIF RIGHT$(T3$,1)=\"0\":  LOCATE x3-1,y3: PRINT\"10\"\r\nIF RIGHT$(T3$,1)<>\"0\": LOCATE x3,y3: PRINT RIGHT$(T3$,1)\r\n\r\n// ----------------------------------------\r\n// Calcul les valeurs des 3 cartes\r\n// ----------------------------------------\r\nREM ----- Calculs des valeurs\r\nIF RIGHT$(T1$,1)=\"0\" THEN T1=10: GOTO @Next2\r\nIF RIGHT$(T1$,1)=\"V\" THEN T1=11: GOTO @Next2\r\nIF RIGHT$(T1$,1)=\"D\" THEN T1=12: GOTO @Next2\r\nIF RIGHT$(T1$,1)=\"R\" THEN T1=13: GOTO @Next2\r\nT1=VAL(T1$)\r\n@Next2\r\nIF RIGHT$(T2$,1)=\"0\" THEN T2=10: GOTO @Next3\r\nIF RIGHT$(T2$,1)=\"V\" THEN T2=11: GOTO @Next3\r\nIF RIGHT$(T2$,1)=\"D\" THEN T2=12: GOTO @Next3\r\nIF RIGHT$(T2$,1)=\"R\" THEN T2=13: GOTO @Next3\r\nT2=VAL(T2$)\r\n@Next3\r\nIF RIGHT$(T3$,1)=\"0\" THEN T3=10: GOTO @Next4\r\nIF RIGHT$(T3$,1)=\"V\" THEN T3=11: GOTO @Next4\r\nIF RIGHT$(T3$,1)=\"D\" THEN T3=12: GOTO @Next4\r\nIF RIGHT$(T3$,1)=\"R\" THEN T3=13: GOTO @Next4\r\nT3=VAL(T3$)\r\n@Next4\r\n\r\n// ----------------------------------------\r\n// Comparaison et score\r\n// ----------------------------------------\r\nREM ----- IF T1 < T3 < T2\r\nIF T1<T3 AND T3<T2 THEN S=S+1\r\nREM ----- IF T1 > T3 > T2\r\nIF T1>T3 AND T3>T2 THEN S=S+1\r\n\r\n// ----------------------------------------\r\n// Auncune carte disponible\r\n// ----------------------------------------\r\nREM ----- fin de deck\r\nIF C$(0)=\"\" AND C$(1)=\"\" AND C$(2)=\"\" AND C$(3)=\"\" THEN @ENDGAME\r\n\r\n// ----------------------------------------\r\n// Nouveau tour\r\n// ----------------------------------------\r\nGOTO @Tour\r\n\r\n\r\n// ----------------------------------------\r\n// Fin de jeu et resultats\r\n// ----------------------------------------\r\nREM ----- Fin de jeu\r\n@ENDGAME\r\n\r\nTJ=TIME-TJ\r\nCLS\r\nPRINT\"Score\";S;: PRINT\"- Temps\";TJ\r\nPRINT\"Votre note: \";\r\nIF S>0  AND S<5  THEN PRINT\"E\": GOTO @Retry\r\nIF S>4  AND S<9  THEN PRINT\"D\": GOTO @Retry\r\nIF S>8  AND S<12 THEN PRINT\"C\": GOTO @Retry\r\nIF S>11 AND S<15 THEN PRINT\"B\": GOTO @Retry\r\nIF S>14 AND S<19 THEN PRINT\"A\": GOTO @Retry\r\n\r\n// ----------------------------------------\r\n// Pour rejour\r\n// ----------------------------------------\r\nREM ----- Rejouer\r\n@Retry\r\nK$=\"\":K$=INKEY$:IF K$=\"\" THEN @Retry\r\nCLS\r\nPRINT\"Voulez-vous rejouer (O/o) ?\"\r\nIF K$=\"O\" OR K$=\"o\" THEN @GAME\r\nEND\r\n\r\n// ----------------------------------------\r\n// Tirage des cartes\r\n// ----------------------------------------\r\n// sur PHC-25, les chaîne débute par 1 et non 0.\r\n@PIQUE\r\nREM ----- Pique\r\n// Chaine vide on va sur un autre tas\r\nIF LEN(C$(0))=0 THEN C=C+1: GOTO @COEUR\r\n// Derniere carte\r\nIF LEN(C$(0))<>1 THEN @TirerPique\r\nR$=C$(0):C$(0)=\"\":GOTO @EndPique\r\n// Reste + de 2 cartes\r\n@TirerPique\r\nV=RND1[LEN(C$(0))]\r\nR$=MID$(C$(0),V,1)\r\nC$(0)=LEFT$(C$(0),V-1)+MID$(C$(0),V+1)\r\n@EndPique\r\nRETURN\r\n\r\n@COEUR\r\nREM ----- Coeur\r\nIF LEN(C$(1))=0 THEN C=C+1: GOTO @CARREAU\r\n// Derniere carte\r\nIF LEN(C$(1))<>1 THEN @TirerCoeur\r\nR$=C$(1):C$(1)=\"\":GOTO @EndCoeur\r\n// Reste + de 2 cartes\r\n@TirerCoeur\r\nV=RND1[LEN(C$(1))]\r\nR$=MID$(C$(1),V,1)\r\nC$(1)=LEFT$(C$(1),V-1)+MID$(C$(1),V+1)\r\n@EndCoeur\r\nRETURN\r\n\r\n@CARREAU\r\nREM ----- Careau\r\nIF LEN(C$(2))=0 THEN C=C+1: GOTO @TREFLE\r\n// Derniere carte\r\nIF LEN(C$(2))<>1 THEN @TirerCarreau\r\nR$=C$(2):C$(2)=\"\":GOTO @EndCarreau\r\n// Reste + de 2 cartes\r\n@TirerCarreau\r\nV=RND1[LEN(C$(2))]\r\nR$=MID$(C$(2),V,1)\r\nC$(2)=LEFT$(C$(2),V-1)+MID$(C$(1),V+1)\r\n@EndCarreau\r\nRETURN\r\n\r\n@TREFLE\r\nREM ----- Trefle\r\nIF LEN(C$(3))=0 THEN C=1: GOTO @PIQUE\r\n\r\n@EndTrefle\r\nRETURN\r\n\r\n// ----------------------------------------\r\n// Init Screen et regles\r\n// ----------------------------------------\r\nREM ----- Initialisation\r\n@INIT\r\nSCREEN 1,0,0:COLOR 1,1,1:CLS\r\nLOCATE 6,0:PRINT\"ACEY DUCEY  Memory\"\r\nLOCATE 8,1:PRINT\"Jeu de 54 cartes\":PRINT\r\n// 32 chars\r\n//    01234567890123456789012345678901\r\nPRINT\" Deviner si la 3eme carte est\"\r\nPRINT\"entre les 2 sorties. Il y a 18\"\r\nPRINT\"tours. Vous choississez si la\"\r\nPRINT\"carte est entre les 2 valeurs\"\r\nPRINT\"par O ou N. Si vous avez raison\"\r\nPRINT\"vous gagnez 1 point. Sinon vous\"\r\nPRINT\"ne gagnez rien.\"\r\nPRINT\" Une note en fin de partie.\"\r\nLOCATE 0,15:PRINT\"Appuyer sur [ENTER].\";\r\n@WaitEnter\r\nK$=INKEY$:IF K$<>CHR$(13) THEN @WaitEnter\r\nRETURN\r\n\r\n\r\n// ----------------------------------------\r\n// cartes 1 à roi (0=10)\r\n// 54/3 = 18 tours\r\n// ----------------------------------------\r\nREM ----- Reset Game\r\n@RESET\r\nI=RND(-TIME)\r\nC$(0)=\"1234567890VDR\":C$(1)=C$(0):C$(2)=C$(0):C$(3)=C$(0)\r\nS=0: REM Score 0\r\nRETURN\r\n\r\n// -----[EOP]------------------------------"}